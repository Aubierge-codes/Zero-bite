# === APPLICATION ===
APP_NAME=Zero_Bite
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_VERSION=v1

# === CORS ===
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === DATABASE ===
# SQLite (default, no setup required):
DATABASE_URL=sqlite+aiosqlite:///./zerobite_dev.db
# Postgres (staging/production):
# DATABASE_URL=postgresql+asyncpg://zerobite:password@localhost:5432/zerobite_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === REDIS ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === SATELLITE DATA ===
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# === WEATHER DATA ===
OPENWEATHER_API_KEY=your_openweather_api_key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# === AFRICA'S TALKING (SMS) ===
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox
AT_SENDER_ID=ZeroBite

# === EMAIL ===
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=alerts@zerobite.rw

# === FIREBASE (Push Notifications) ===
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-credentials.json

# === ML MODEL ===
MODEL_PATH=models/risk_classifier.joblib
SCALER_PATH=models/feature_scaler.joblib
MODEL_RETRAIN_THRESHOLD=50
PREDICTION_CONFIDENCE_THRESHOLD=0.65

# === GEOGRAPHIC ===
DEFAULT_COUNTRY=Rwanda
DEFAULT_EPSG=32736
GRID_RESOLUTION_METERS=500
RIVER_BUFFER_METERS=200

# === RISK THRESHOLDS ===
# Must match trainer.py engineer_labels() and predictor.py classify_risk()
CRITICAL_RISK_THRESHOLD=0.80
HIGH_RISK_THRESHOLD=0.65
MODERATE_RISK_THRESHOLD=0.35
ALERT_LEAD_TIME_HOURS=24
