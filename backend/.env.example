# === APPLICATION ===
APP_NAME=Zero_Bite
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_VERSION=v1

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://zerobite:password@localhost:5432/zerobite_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === REDIS ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === SATELLITE DATA ===
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
SENTINEL_API_URL=https://scihub.copernicus.eu/dhus/

# === WEATHER DATA ===
OPENWEATHER_API_KEY=your_openweather_api_key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
CHIRPS_DATA_DIR=/data/chirps

# === AFRICA'S TALKING (SMS) ===
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox
AT_SENDER_ID=ZeroBite

# === EMAIL ===
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=alerts@zerobite.rw

# === FIREBASE (Push Notifications) ===
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-credentials.json

# === ML MODEL ===
MODEL_PATH=/models/risk_classifier.joblib
SCALER_PATH=/models/feature_scaler.joblib
MODEL_RETRAIN_THRESHOLD=500
PREDICTION_CONFIDENCE_THRESHOLD=0.65

# === GEOGRAPHIC ===
DEFAULT_COUNTRY=Rwanda
DEFAULT_EPSG=32736
GRID_RESOLUTION_METERS=500
RIVER_BUFFER_METERS=200

# === ALERTS ===
HIGH_RISK_THRESHOLD=0.70
MODERATE_RISK_THRESHOLD=0.40
ALERT_LEAD_TIME_HOURS=24

# === DRONE ===
MAX_DRONES=5
DRONE_RANGE_KM=15
DRONE_SPEED_KMH=40

# === SCHEDULER ===
DATA_INGESTION_INTERVAL_HOURS=6
PREDICTION_RUN_INTERVAL_HOURS=12
MODEL_RETRAIN_INTERVAL_DAYS=7
